<ObjectRepositoryTargetData ContentHash="w93VhSyvvUOH-HnDCt9vuQ" xmlns="http://schemas.uipath.com/workflow/activities/uix" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ObjectRepositoryTargetData.Data>
    <TargetAnchorable x:Key="TargetAnchorable" BrowserURL="dfohrgolden.plateau.com/learning/admin/theming/updateThemingInfo.do" DesignTimeRectangle="745, 525, 3101, 1772" DesignTimeScaleFactor="2.25" FullSelectorArgument="&lt;ctrl name='Opplæringsadministrasjon' role='document' /&gt;&lt;ctrl name='Systemkonfigurasjon' role='document' /&gt;" FuzzySelectorArgument="&lt;ctrl name='Opplæringsadministrasjon' role='document' /&gt;&lt;ctrl name='Systemkonfigurasjon' role='document' automationid='' check:fulltext='Systemkonfigurasjon  |    | &amp;#xD;&amp;#xA;&amp;gt; Systemkonfigurasjon&amp;#xD;&amp;#xA;&amp;#xA;&amp;#xD;&amp;#xA;Konfigurasjon&amp;#xD;&amp;#xA;Konfigurasjons-ID Beskrivelse&amp;#xD;&amp;#xA;ADMIN QUICK LINKS    Denne konfigurasjonen inneholder standard hurtigkoblinger og grupper som følger med systemet (Systemadmin&amp;gt;Konfigurasjon&amp;gt;Konfigurasjon av hurtigkoblinger). &amp;#xD;&amp;#xA;AICC    Denne konfigurasjonen inneholder de leverandørspesifikke tilordningene for leksjonsstatus for AICC. &amp;#xD;&amp;#xA;ATTACHMENT    Denne konfigurasjonen inneholder dokumentkoblingen for vedleggsinnstillinger. &amp;#xD;&amp;#xA;AUTHENTICATION    Denne konfigurasjonen inneholder informasjon for systemadministrator for autentiseringsrelaterte konfigurasjonsalternativer. &amp;#xD;&amp;#xA;BEST PRACTICES    [Bare sertifiserte konsulenter og implementeringspartnere] Denne konfigurasjonen inneholder innstillingene for innholdsoppgraderingene for SAP Best Practices. &amp;#xD;&amp;#xA;BIBLIOTEK    Denne konfigurasjonen inneholder bibliotekrelaterte innstillinger &amp;#xD;&amp;#xA;BIZX    Denne konfigurasjonen inneholder innstillingene for oppsett av SuccessFactors BizX-integrering med Learning. &amp;#xD;&amp;#xA;BOOTSTRAP-PAYMENT-GATEWAY    Denne konfigurasjonen inneholder bootstrap-konfigurasjon for betalingsportalen. &amp;#xD;&amp;#xA;CERTIFICATE IMAGE ATTACHMENT    Denne konfigurasjonen inneholder vedleggsinnstillinger for sertifikatbildet. &amp;#xD;&amp;#xA;COLLECTION IMAGE ATTACHMENT    Denne konfigurasjonen inneholder innstillinger for samlingsbildevedlegget. &amp;#xD;&amp;#xA;CONNECTORS    Denne konfigurasjonen inneholder egenskapene for SuccessFactors-koblingene. &amp;#xD;&amp;#xA;CONTENT IMPORT    Denne konfigurasjonen inneholder innstillinger for import av innhold. &amp;#xD;&amp;#xA;CSRF_GUARD    Denne konfigurasjonen inneholder innstillingene for CSRF Guard. &amp;#xD;&amp;#xA;DIRECT_LINK    Dette vil administrere direktekoblingskonfigurasjonen &amp;#xD;&amp;#xA;ENTITY_IMPORT    Denne konfigurasjonen inneholder innstillingene for import av entitet. &amp;#xD;&amp;#xA;FINANCIAL    Denne konfigurasjonen inneholder innstillingene for det økonomiske rammeverket. &amp;#xD;&amp;#xA;GAMIFICATION    Denne konfigurasjonen inneholder innstillinger for tjenesteintegrering av spillifisering. &amp;#xD;&amp;#xA;ICONTENT    Configuration Settings for iContent Integration. &amp;#xD;&amp;#xA;IMAGE ATTACHMENT    Denne konfigurasjonen inneholder innstillingene for bildevedlegg. &amp;#xD;&amp;#xA;INCLUDE USER PUBLISHED CONTENT    Denne konfigurasjonen inneholder innstillinger for brukergenerert innhold. &amp;#xD;&amp;#xA;LDAP    LDAP.properties &amp;#xD;&amp;#xA;LEARNER_SECURITY    Denne konfigurasjonen inneholder innstillingene for arbeidsflyt og begrensning for BRUKER. &amp;#xD;&amp;#xA;LMS_ADMIN    Denne konfigurasjonen inneholder systemadministratorinformasjon som er påkrevd for å kunne tilpasse ELMS-programmet. &amp;#xD;&amp;#xA;MARKEDSPLASS    Denne konfigurasjonen inneholder innstillinger for oppsett av SAP Hybris-integrering med Kurs &amp;#xD;&amp;#xA;MOBIL    Denne konfigurasjonen inneholder mobilrelaterte innstillinger. &amp;#xD;&amp;#xA;MODULE_TABS_SYSTEM    Konfigurasjon for kategorien Elev inneholder all pwa-kategoriinformasjon og informasjon som er påkrevd for å tilpasse kategorier for alle programmer. &amp;#xD;&amp;#xA;MÅLOPPNÅELSE FOR LÆRING    Denne konfigurasjonen inneholder innstillinger relatert til måloppnåelse for læring &amp;#xD;&amp;#xA;OPEN CONTENT NETWORK    Denne konfigurasjonen inneholder innstillinger for nettverk med åpent innhold. &amp;#xD;&amp;#xA;PARTNER_EXTRACT    Denne konfigurasjonen inneholder Partner Extract-relaterte innstillinger &amp;#xD;&amp;#xA;PASSWORD_POLICY    Systemkonfigurasjon for passordpolicy &amp;#xD;&amp;#xA;REPORT    Konfigurasjon av rapportrammeverk &amp;#xD;&amp;#xA;REPORT_SYSTEM    Konfigurasjon av rapportsystem &amp;#xD;&amp;#xA;SAP CLOUD IDENTITY SERVICES    Denne konfigurasjonen inneholder innstillinger for SAP Cloud Identity Services-integrering med Kurs &amp;#xD;&amp;#xA;SEARCH    Denne konfigurasjonen inneholder de generelle administratorinnstillingene for rammeverket for søk. &amp;#xD;&amp;#xA;USER LEARNING PLAN    Inneholder konfigurasjonsinnstillinger for brukeren (eleven) inkludert opplæringsplan og pensumdetaljer. &amp;#xD;&amp;#xA;VEDLEGG MED EMNEBANNERBILDE    Denne konfigurasjonen inneholder kategorinnstillingene for bannerbildet. &amp;#xD;&amp;#xA;VEDLEGG MED SAMTYKKEERKLÆRINGER    Denne konfigurasjonen inneholder vedleggsinnstillinger for samtykkeerklæringer for brukere. &amp;#xD;&amp;#xA;WEB_SECURITY    Nettsikkerhetsinnstillinger. &amp;#xD;&amp;#xA;WORKFORCE PERFORMANCE BUILDER CONFIGURATION    Denne konfigurasjonen inneholder egenskapene som kreves for å importere SCORM-innhold via REST-API.' /&gt;" Guid="70fe0dbf-53ee-4518-9645-3d2c35ba2aff" ScopeSelectorArgument="&lt;wnd app='msedge.exe' cls='Chrome_WidgetWin_1' title='Opplæringsadministrasjon og 1 side til – [InPrivate] – Microsoft*' /&gt;" SearchSteps="Selector, FuzzySelector" SelectionStrategy="AA" Version="V4" Visibility="Interactive">
