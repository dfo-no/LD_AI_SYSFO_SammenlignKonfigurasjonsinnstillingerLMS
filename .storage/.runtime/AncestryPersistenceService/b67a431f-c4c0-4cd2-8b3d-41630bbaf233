hould implement com.plateausystems.elms.bo.authentication.helper.CustomizableAuthentication and can be tailored to authenticate against other data sources (other databases, ldap, etc.)\nhandlerClassName.USER=com.plateausystems.elms.bo.authentication.helper.PwsElmsAuthentication\n\n# The authentication settings\n# CAS is disabled(set to false) by default. Do not set to true, this setting to be used for future release only. \ncasEnabled=false\n\n# SSO Authentication Token expiration time in seconds, this time in seconds will be used when generating the SSO auth token and expiration date set on that\n# token is (currentTimestamp during generation of the ticket + lapse time)\nssoTokenLapseTimeInSeconds=180\n\n# The tms spring remoting (web service) authentication is enabled by default. To disable the authentication, you need to set springRemotingAuthenticationEnabled to false\n# AND provide a default remoting user. We recommend creating an admin user without assigning any roles for better security.\nspringRemotingAuthenticationEnabled=true\ndefaultSpringRemotingUser=Please specify an admin user here when springRemotingAuthenticationEnabled is disabled\n\n# Authentication Providers for the Admin's application\n# The providers will be used in the sequential order during the authentication.\n# The out of box providers are adminDaoAuthenticationProvider and the adminLdapAuthenticationProvider, which are defined in the defined in the\n# ElmsSecurityContext.xml\n# Use the adminLdapAuthenticationProvider.AD for Active directory Server LDAP\n# Use the adminHostingLdapAuthenticationProvider.AD for Active directory Server LDAP Hosting\nauthenticationProviders.ADMIN[adminLdapAuthenticationProvider]=false\nauthenticationProviders.ADMIN[adminDaoAuthenticationProvider]=true\nauthenticationProviders.USER[learnerLdapAuthenticationProvider]=false\nauthenticationProviders.USER[learnerDaoAuthenticationProvider]=true\nauthenticationProviders.ADMIN[adminHostingLdapAuthenticationProvider.AD]=true\nauthenticationProviders.ADMIN[adminHostingLdapAuthenticationProvider]=false\n\n# Set to true if related admins and users can switch between the admin and user interface without re-logging in\ncrossAppEnabled=true\n\n# The value of HTTPSessionTimeout is passed to HTTPSession.setMaxInactiveInterval() each time a session is created.\n# As of Servlets 2.2-2.5, that implementation accepts values specified in seconds. For example: 1800 is 30 minutes.\n# This overrides the value specified in web.xml for the session timeout (in the session-config/session-timeout element).\n# The minimum value for httpSessionTimeout is 1800 seconds, and the upper limit is 28800 seconds.\nhttpSessionTimeout=1800\n\n# LoginPolicy determines the system behavior during user login process.\n# \"lockout\" enables/disables the check for the number of times an admin/user tries to login.\n#   If it is set to true the LMS will lock out the admin/user after n login failures (The number of login failures can be set in Admin/System Admin/Login Attempts).\n#   If it is set to false the number of login failures cannot be edited and the admin/user may attempt to login any number of times.\n# \"forcePasswordExpriation\" specifies to turn on or off the \"immediately change password\" feature.\n#   This allows clients with LDAP to turn this feature off, which prevents users from having to immediately change their passwords (after first login or after administrator forced password reset).\n# \"caseSensitivePassword\" specifies whether the password match during User login should be a case sensitive match or not.\nloginPolicy.ADMIN.lockout=true\nloginPolicy.ADMIN.forcePasswordExpiration=true\nloginPolicy.ADMIN.caseSensitivePassword=true\nloginPolicy.USER.lockout=true\nloginPolicy.USER.forcePasswordExpiration=true\nloginPolicy.USER.caseSensitivePassword=true\n\n# If the user/admin flag is set to true, then end user/admin IDs become case sensitive. The end user/admin IDs JOHN_DOE and john_doe\n# are treated as two different IDs. If set to false, then JOHN_DOE and john_doe are treated as the same ID.\n# The user and admin flag applies to user and administrator IDs respectively.\n# By default, both the admin and the user flag are set to true.\n# The system won't allow duplicate users/admins with Ids that differ only in case to be authenticated if the flag(s) is set as false.\n# With user flag set to false, the system will validate users created by Admin GUI, Self Registration with and without approval for both site and non-site are not duplicate users.\nloginPolicy.ADMIN.caseSensitiveID=true\nloginPolicy.USER.caseSensitiveID=true\n\n\n#**************************************************************************************************\n# EXTERNALIZED FOR USE BY PLATEAU SERVICES: DO NOT CHANGE\n# URIs that are used when an authentication check fails (e.g. on session invalidation) and the user needs to be forwarded to a login page from inside the application\nloginURI.ADMIN=/admin/login.do\nloginURI.ADMIN_NATIVE=/admin/nativelogin.do\nloginURI.USER=/user/login.do\nloginURI.USER_NATIVE=/user/nativelogin.do\nloginURI.SITE=/user/portal.do?siteID={siteid}\n\n# The list of URIs in FilterConfig are URIs that do *not* require user log in: users do not need to be logged\n# into a session to go to the URI. Do not change without assistance from Plateau Services.\n# CheckLearnerLogonFilter\nexcludedFilterURIs.USER[/user/login_mobile_bizx.jsp]=true\nexcludedFilterURIs.USER[/user/site/successAuthenticate.do]=true\nexcludedFilterURIs.USER[/user/site/failedAuthenticate.do]=true\nexcludedFilterURIs.USER[/user/site/siteSelfRegisterInit.do]=true\nexcludedFilterURIs.USER[/user/site/selfRegisterFromSite.do]=true\nexcludedFilterURIs.USER[/user/successAuthenticate.do]=true\nexcludedFilterURIs.USER[/user/failedAuthenticate.do]=true\nexcludedFilterURIs.USER[/user/login.do]=true\nexcludedFilterURIs.USER[/user/nativelogin.do]=true\nexcludedFilterURIs.USER[/user/forgotID.do]=true\nexcludedFilterURIs.U