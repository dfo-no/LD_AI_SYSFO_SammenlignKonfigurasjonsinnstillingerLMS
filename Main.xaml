       End If&#xA;&#xA;    End If&#xA;&#xA;Next&#xA;&#xA;&#xA;updatedConfigText = String.Join(Environment.NewLine, result)" DisplayName="Invoke Code - Unntak oppdatering" sap:VirtualizedContainerService.HintSize="434,329" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
